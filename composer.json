{
    "name": "edutecka/edpay-php-sdk",
    "description": "Official EDPay SDK for PHP and Laravel with multi-gateway payments, checkout, payment links, invoicing, customers, and webhook verification.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Equipa de Engenharia EDPay",
            "email": "dev@edutecka.com",
            "homepage": "https://edutecka.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0"
    },
    "autoload": {
        "psr-4": {
            "EDPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EDPay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EDPay\\Laravel\\EdpayServiceProvider"
            ],
            "aliases": {
                "Edpay": "EDPay\\Laravel\\Facades\\Edpay"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
